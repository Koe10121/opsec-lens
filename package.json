{
  "name": "opsec-lens",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "predev": "node scripts/copy-tesseract.mjs",
    "dev": "vite",
    "build-ip-orgs": "tsx scripts/build-ip-orgs.ts",
    "prebuild": "node scripts/copy-tesseract.mjs && tsx scripts/build-ip-orgs.ts",
    "build": "vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "e2e": "playwright test",
    "make-sample": "node scripts/make-sample.mjs",
    "make-visual-sample": "tsx scripts/make-visual-sample.ts",
    "time-ocr": "node scripts/time-ocr.mjs",
    "benchmark:generate": "python benchmark/generate --seed 1 --n 300",
    "benchmark:score": "tsx benchmark/score.ts"
  },
  "dependencies": {
    "jsqr": "^1.4.0",
    "onnxruntime-web": "^1.31.1",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.1.0",
    "@playwright/test": "^1.65.0",
    "@types/qrcode": "^1.5.6",
    "qrcode": "^1.5.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
